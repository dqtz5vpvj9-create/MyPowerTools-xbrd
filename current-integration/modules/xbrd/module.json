{
  "schemaVersion": "1.0",
  "id": "xbrd",
  "packageId": "xbrd",
  "displayName": "XBRD 屏幕",
  "version": "0.1.0",
  "moduleSdk": "1.0",
  "entrypoints": [],
  "capabilities": [
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "service",
    "allowInProc": false,
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "service-required",
      "systemMutation": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "permissions": [],
  "requires": [
    {
      "capability": "network.ssh",
      "required": false,
      "reason": "读取远端 XBRD 发布器状态与部署动作。"
    }
  ],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
