{
  "schemaVersion": "1.0",
  "commands": [
    {
      "id": "xbrd.open.panel",
      "title": "打开 XBRD 面板",
      "subtitle": "内嵌路由器管理页",
      "kind": "open",
      "category": "XBRD",
      "execution": {
        "type": "navigation",
        "toolId": "xbrd",
        "routeId": "panel"
      }
    },
    {
      "id": "xbrd.open.sources",
      "title": "打开 XBRD 来源与配额",
      "subtitle": "9 个信息来源的状态与 TTL 健康",
      "kind": "open",
      "category": "XBRD",
      "execution": {
        "type": "navigation",
        "toolId": "xbrd",
        "routeId": "sources"
      }
    },
    {
      "id": "xbrd.health",
      "title": "检查 XBRD 面板与来源健康",
      "subtitle": "GET {publisherUrl}/health",
      "kind": "action",
      "category": "XBRD",
      "timeoutMs": 8000,
      "execution": {
        "type": "http.request",
        "method": "GET",
        "path": "/health"
      }
    },
    {
      "id": "xbrd.sources.reload",
      "title": "重新读取 XBRD 来源清单",
      "subtitle": "GET {publisherUrl}/api/v1/sources",
      "kind": "action",
      "category": "XBRD",
      "timeoutMs": 8000,
      "execution": {
        "type": "http.request",
        "method": "GET",
        "path": "/api/v1/sources"
      }
    }
  ]
}
