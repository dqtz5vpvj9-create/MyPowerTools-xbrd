<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Xbrd.Surface</AssemblyName>
    <RootNamespace>Xbrd.Surface</RootNamespace>
    <!-- The tool is registered in scripts/build-all-tools.ps1, which packs every Surface
         project; IsPackable=false made `dotnet pack` emit nothing, so
         build-tool-packages failed. Match the other first-party Surfaces. -->
    <IsPackable>true</IsPackable>
    <PackageId>Xbrd.Surface</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.AvaloniaSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.UI" Version="0.2.0" />
    <!--
      The Surface reads the tool's own settings (publisherUrl / xbrdRepoRoot / …) through the same
      host contract the Shell uses to expand ${settings.*}: the Runner's tool descriptor points at
      <toolDir>/ui/settings.json. Read-only; the routerToken secret is never requested or logged.
      Same dependency set as AdbForwarder.Surface / RemoteNotifications.Surface.
    -->
    <PackageReference Include="MyPowerTools.HostControl.Client" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Protocol" Version="0.2.0" />
  </ItemGroup>
</Project>
