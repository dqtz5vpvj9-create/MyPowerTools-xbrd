<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:services="using:Xbrd.Surface.Services"
             xmlns:vm="using:Xbrd.Surface.ViewModels"
             x:Class="Xbrd.Surface.Views.XbrdSourcesView"
             x:DataType="vm:XbrdSourcesViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{DynamicResource MptPagePadding}"
                  Spacing="{DynamicResource MptSpacingL}"
                  MaxWidth="1600"
                  HorizontalAlignment="Stretch">

        <!-- ── 顶部聚合状态 + 全部刷新 ─────────────────────────────────────── -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
          <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
            <TextBlock Classes="MptPageTitle" Text="XBRD 来源与配额" />
            <TextBlock Classes="MptPageSubtitle"
                       Text="每行动作都直达生产端：路由器控制面（refresh/停用/注销/日志）、本工具 Service Unit（立即发布/停启）、UI Quota Worker（立即采集/验证窗口）" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource MptSpacingS}"
                      VerticalAlignment="Center">
            <Border Classes="MptStatusBadge"
                    Classes.running="{Binding AggregateIsReady}"
                    Classes.degraded="{Binding AggregateIsDegraded}"
                    Classes.error="{Binding AggregateIsError}">
              <TextBlock Classes="MptMeta"
                         Text="{Binding AggregateHeadline, StringFormat='聚合状态：{0}'}" />
            </Border>
            <controls:MptButton Content="全部刷新"
                                Command="{Binding RefreshAllCommand}"
                                IsEnabled="{Binding !IsRefreshAllRunning}"
                                ToolTip.Tip="{Binding RefreshAllHint}" />
            <controls:MptButton Content="刷新快照"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </Grid>

        <!-- ── 全部刷新进度与逐项结果 ──────────────────────────────────────── -->
        <Border Classes="MptCard" IsVisible="{Binding HasRefreshAllProgress}">
          <StackPanel Spacing="{DynamicResource MptSpacingS}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
              <TextBlock FontWeight="SemiBold" Text="全部刷新" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="MptMeta" VerticalAlignment="Center" Text="{Binding RefreshAllProgressText}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshAllRunning}" Height="3" />
            <ItemsControl ItemsSource="{Binding RefreshAllResults}" IsVisible="{Binding HasRefreshAllResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:XbrdRefreshAllResult">
                  <Border Classes="MptStatusBadge"
                          Classes.running="{Binding IsReady}"
                          Classes.error="{Binding IsError}"
                          Margin="{DynamicResource MptWrapItemCompactMargin}">
                    <TextBlock Classes="MptMeta" Text="{Binding Text}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="MptCard" IsVisible="{Binding ShowsSettingsWarning}">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock FontWeight="SemiBold" Text="设置降级" />
            <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding SettingsWarningText}" />
          </StackPanel>
        </Border>

        <!-- ── 三个聚合指标 ───────────────────────────────────────────────── -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource MptSpacingM}">
          <Border Grid.Column="0" Classes="MptCard">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" Text="面板可达性" />
              <Border Classes="MptStatusBadge"
                      Classes.running="{Binding PanelIsReady}"
                      Classes.degraded="{Binding PanelIsDegraded}"
                      Classes.error="{Binding PanelIsError}">
                <TextBlock Text="{Binding PanelLabel}" />
              </Border>
              <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding PanelDetail}" />
              <TextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding PanelEndpoint}" />
              <TextBlock Classes="MptMeta" Text="{Binding PanelCountersText}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="MptCard">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" Text="来源健康" />
              <Border Classes="MptStatusBadge"
                      Classes.running="{Binding SourcesIsReady}"
                      Classes.degraded="{Binding SourcesIsDegraded}"
                      Classes.error="{Binding SourcesIsError}">
                <TextBlock Text="{Binding SourcesLabel}" />
              </Border>
              <TextBlock Text="{Binding SourcesSummaryText}" />
              <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding ControlPlaneText}" />
              <TextBlock Classes="MptMeta" Text="{Binding LastUpdatedText, StringFormat='更新时间 {0}'}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="MptCard">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" Text="采集服务" />
              <Border Classes="MptStatusBadge"
                      Classes.running="{Binding UnitsIsReady}"
                      Classes.degraded="{Binding UnitsIsDegraded}"
                      Classes.error="{Binding UnitsIsError}">
                <TextBlock Text="{Binding UnitsLabel}" />
              </Border>
              <TextBlock TextWrapping="Wrap" Text="{Binding UnitsSummaryText}" />
              <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding UnitsDetail}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- ── 面板数据预览（原始 panel JSON；可读 UI 见 /panel-app/） ── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                <TextBlock Classes="MptSectionTitle" Text="面板数据预览" Margin="{DynamicResource MptNoThickness}" />
                <TextBlock Classes="MptMeta"
                           TextWrapping="Wrap"
                           Text="原始 panel JSON（设备与发布器的原始数据入口）；可读 UI 见 /panel-app/（复用手机端配额 UI）。这里只保留 /panel-app/ 不展示的 status / weather / plan —— quota 只在面板 Tab 呈现，不在此重复。" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding PanelPreviewMetaText}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource MptSpacingS}"
                          VerticalAlignment="Center">
                <Border Classes="MptStatusBadge"
                        Classes.running="{Binding PanelPreviewIsReady}"
                        Classes.degraded="{Binding PanelPreviewIsDegraded}"
                        Classes.error="{Binding PanelPreviewIsError}">
                  <TextBlock Classes="MptMeta" Text="{Binding PanelPreviewLabel}" />
                </Border>
                <TextBlock Classes="MptMeta"
                           VerticalAlignment="Center"
                           Text="{Binding PanelPreviewUpdatedText, StringFormat='updated {0}'}" />
              </StackPanel>
            </Grid>

            <Border Classes="MptInset" IsVisible="{Binding HasPanelPreviewError}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock FontWeight="SemiBold" Text="面板数据不可用（已降级，不影响下方区域）" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding PanelPreviewErrorText}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="面板状态（status）" />
              <ItemsControl ItemsSource="{Binding PanelStatusFields}" IsVisible="{Binding HasPanelStatus}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:XbrdPanelField">
                    <Border Classes="MptStatusBadge"
                            Classes.running="{Binding IsReady}"
                            Classes.degraded="{Binding IsDegraded}"
                            Classes.error="{Binding IsError}"
                            Margin="{DynamicResource MptWrapItemCompactMargin}">
                      <TextBlock Classes="MptMeta" Text="{Binding Display}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="MptMeta" IsVisible="{Binding !HasPanelStatus}" Text="面板数据未包含 status 字段。" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="天气（weather）" />
              <ItemsControl ItemsSource="{Binding PanelWeatherFields}" IsVisible="{Binding HasPanelWeather}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:XbrdPanelField">
                    <Border Classes="MptInset" Margin="{DynamicResource MptWrapItemCompactMargin}">
                      <TextBlock Classes="MptMeta" Text="{Binding Display}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="MptMeta" IsVisible="{Binding !HasPanelWeather}" Text="面板数据未包含 weather 字段。" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="计划（plan）" />
              <ItemsControl ItemsSource="{Binding PanelPlanFields}" IsVisible="{Binding HasPanelPlan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:XbrdPanelField">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{DynamicResource MptSpacingM}"
                          Margin="{DynamicResource MptGapBottomXs}">
                      <TextBlock Classes="MptMeta" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="MptMeta" IsVisible="{Binding !HasPanelPlan}" Text="面板数据未包含 plan 字段。" />
              <TextBlock Classes="MptMeta"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasPanelPlanTodos}"
                         Text="{Binding PanelPlanTodosText}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ── 来源清单（管理面） ─────────────────────────────────────────── -->
        <Border Classes="MptCard" Padding="{DynamicResource MptNoThickness}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingM}"
                  Margin="{DynamicResource MptUniformL}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                <TextBlock Classes="MptSectionTitle" Text="来源管理" Margin="{DynamicResource MptNoThickness}" />
                <TextBlock Classes="MptMeta" Text="{Binding SourcesSummaryText}" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding SourcesMetaText}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource MptSpacingS}"
                          VerticalAlignment="Center">
                <controls:MptButton Content="全部刷新"
                                    Command="{Binding RefreshAllCommand}"
                                    IsEnabled="{Binding !IsRefreshAllRunning}" />
                <controls:MptButton Content="刷新快照" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </Grid>

            <Border Classes="MptInset" IsVisible="{Binding HasControlPlaneWarning}" Margin="{DynamicResource MptHorizontalLMargin}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock FontWeight="SemiBold" Text="控制面降级（动作能力受限）" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding ControlPlaneWarningText}" />
              </StackPanel>
            </Border>

            <Border Classes="MptInset" IsVisible="{Binding HasSourcesError}" Margin="{DynamicResource MptGapTopS}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock FontWeight="SemiBold" Text="来源清单读取失败（已降级显示）" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding SourcesErrorText}" />
              </StackPanel>
            </Border>

            <Border Classes="MptEmptyState"
                    IsVisible="{Binding IsSourcesEmpty}"
                    Margin="{DynamicResource MptHorizontalLMargin}">
              <TextBlock Classes="MptEmptyState" Text="发布器返回了 0 个来源。" />
            </Border>

            <!-- 表头 -->
            <Border Background="{DynamicResource MptBrushSurfaceMuted}" Padding="{DynamicResource MptCompactPadding}">
              <Grid ColumnDefinitions="1.3*,1.15*,1.0*,1.55*,1.15*,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
                <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="来源 / 类型" />
                <TextBlock Grid.Column="1" Classes="MptMeta" FontWeight="SemiBold" Text="状态" />
                <TextBlock Grid.Column="2" Classes="MptMeta" FontWeight="SemiBold" Text="TTL 剩余" />
                <TextBlock Grid.Column="3" Classes="MptMeta" FontWeight="SemiBold" Text="错误原文" />
                <TextBlock Grid.Column="4" Classes="MptMeta" FontWeight="SemiBold" Text="归属" />
                <TextBlock Grid.Column="5" Classes="MptMeta" FontWeight="SemiBold" Text="动作（真执行）" />
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:XbrdSourceRowViewModel">
                  <Border BorderBrush="{DynamicResource MptBrushDivider}"
                          BorderThickness="0,0,0,1"
                          Padding="{DynamicResource MptCompactPadding}">
                    <StackPanel Spacing="{DynamicResource MptSpacingS}">
                      <Grid ColumnDefinitions="1.3*,1.15*,1.0*,1.55*,1.15*,Auto"
                            ColumnSpacing="{DynamicResource MptSpacingS}">
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                          <TextBlock Classes="MptMono" Text="{Binding SourceId}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="MptMeta" Text="{Binding KindText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                          <Border Classes="MptStatusBadge"
                                  Classes.running="{Binding IsReady}"
                                  Classes.degraded="{Binding IsDegraded}"
                                  Classes.error="{Binding IsError}">
                            <TextBlock Classes="MptMeta" Text="{Binding StatusLabel}" />
                          </Border>
                          <TextBlock Classes="MptMeta"
                                     IsVisible="{Binding ShowDisabledBadge}"
                                     Text="{Binding EnabledText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TtlText}" TextWrapping="Wrap" />
                          <TextBlock Classes="MptMeta" Text="{Binding TtlDetailText}" />
                        </StackPanel>

                        <Grid Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock Foreground="{DynamicResource MptBrushDanger}"
                                     IsVisible="{Binding HasError}"
                                     MaxLines="3"
                                     TextTrimming="CharacterEllipsis"
                                     TextWrapping="Wrap"
                                     Text="{Binding ErrorText}" />
                          <TextBlock Classes="MptMeta" IsVisible="{Binding !HasError}" Text="无" />
                        </Grid>

                        <TextBlock Grid.Column="4"
                                   Classes="MptMeta"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding OwnerText}" />

                        <StackPanel Grid.Column="5" Spacing="{DynamicResource MptSpacingXs}" VerticalAlignment="Center">
                          <WrapPanel>
                            <controls:MptButton Content="立即刷新"
                                                Command="{Binding RefreshCommand}"
                                                IsVisible="{Binding ShowRefreshAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="{Binding ToggleEnabledText}"
                                                Command="{Binding ToggleEnabledCommand}"
                                                IsVisible="{Binding ShowToggleEnabledAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="日志"
                                                Command="{Binding LoadLogCommand}"
                                                IsVisible="{Binding ShowLogAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="注销"
                                                Command="{Binding ArmDeleteCommand}"
                                                IsVisible="{Binding ShowDeleteAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="立即发布"
                                                Command="{Binding PublishNowCommand}"
                                                IsVisible="{Binding ShowPublishNowAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="{Binding UnitToggleText}"
                                                Command="{Binding ToggleUnitCommand}"
                                                IsVisible="{Binding ShowUnitToggleAction}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="立即采集"
                                                Command="{Binding CollectUiQuotaCommand}"
                                                IsVisible="{Binding ShowUiQuotaActions}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="验证窗口"
                                                Command="{Binding OpenQuotaWindowCommand}"
                                                IsVisible="{Binding ShowUiQuotaActions}"
                                                IsEnabled="{Binding IsIdle}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="查看快照"
                                                Command="{Binding ShowSnapshotCommand}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                          </WrapPanel>

                          <!-- 注销二次确认 -->
                          <WrapPanel IsVisible="{Binding IsDeleteConfirming}">
                            <TextBlock Classes="MptMeta"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MptBrushDanger}"
                                       Text="注销会从路由器状态与 panel 中移除该来源，不可撤销。确认？"
                                       Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="确认注销"
                                                Command="{Binding ConfirmDeleteCommand}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                            <controls:MptButton Content="取消"
                                                Command="{Binding CancelDeleteCommand}"
                                                Margin="{DynamicResource MptWrapItemCompactMargin}" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>

                      <!-- 动作进行中 / 动作证据 -->
                      <StackPanel IsVisible="{Binding IsBusy}" Spacing="{DynamicResource MptSpacing2Xs}">
                        <TextBlock Classes="MptMeta" Text="{Binding BusyText}" />
                        <ProgressBar IsIndeterminate="True" Height="3" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding HasOutcome}" Spacing="{DynamicResource MptSpacing2Xs}">
                        <Border Classes="MptStatusBadge"
                                Classes.running="{Binding OutcomeIsOk}"
                                Classes.error="{Binding OutcomeIsError}">
                          <TextBlock Classes="MptMeta" Text="{Binding OutcomeLabel}" />
                        </Border>
                        <Border Classes="MptInset">
                          <SelectableTextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding OutcomeText}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- ── 采集器与 Service Unit 状态 ─────────────────────────────────── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                <TextBlock Classes="MptSectionTitle" Text="采集器与 Service Unit" Margin="{DynamicResource MptNoThickness}" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding UnitsDetail}" />
              </StackPanel>
            </Grid>

            <Border Classes="MptInset" IsVisible="{Binding HasServiceUnitsError}">
              <TextBlock TextWrapping="Wrap" Text="{Binding ServiceUnitsErrorText}" />
            </Border>

            <ItemsControl ItemsSource="{Binding ServiceUnits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:XbrdServiceUnitRowViewModel">
                  <Border Classes="MptLogRow" Margin="{DynamicResource MptGapBottomXs}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
                      <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                          <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                          <TextBlock Classes="MptMono" VerticalAlignment="Center" Text="{Binding UnitId}" />
                        </StackPanel>
                        <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DetailText}" />
                        <TextBlock Foreground="{DynamicResource MptBrushDanger}"
                                   IsVisible="{Binding HasError}"
                                   TextWrapping="Wrap"
                                   Text="{Binding LastErrorText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="{DynamicResource MptSpacingXs}"
                                  VerticalAlignment="Center">
                        <Border Classes="MptStatusBadge"
                                Classes.running="{Binding IsReady}"
                                Classes.degraded="{Binding IsDegraded}"
                                Classes.error="{Binding IsError}">
                          <TextBlock Classes="MptMeta" Text="{Binding StateLabel}" />
                        </Border>
                        <controls:MptButton Content="{Binding ToggleButtonText}"
                                            Command="{Binding ToggleCommand}"
                                            IsEnabled="{Binding Installed}" />
                        <controls:MptButton Content="重启"
                                            Command="{Binding RestartCommand}"
                                            IsEnabled="{Binding Installed}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 每日 UI Quota 计划任务 -->
            <Border Classes="MptLogRow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
                <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock FontWeight="SemiBold" Text="每日 UI Quota 计划任务" />
                    <TextBlock Classes="MptMono" VerticalAlignment="Center" Text="{Binding UiQuotaTaskName}" />
                  </StackPanel>
                  <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding UiQuotaTask.DetailText}" />
                  <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding UiQuotaTask.LatestLogText}" />
                  <TextBlock Classes="MptMeta"
                             TextWrapping="Wrap"
                             Text="{Binding UiQuotaTask.TaskToRunText, StringFormat='Task To Run: {0}'}" />
                  <TextBlock Classes="MptMeta"
                             TextWrapping="Wrap"
                             Text="{Binding UiQuotaTask.LogDirectoryText, StringFormat='日志目录：{0}'}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource MptSpacingXs}"
                            VerticalAlignment="Center">
                  <Border Classes="MptStatusBadge"
                          Classes.running="{Binding UiQuotaTask.IsReady}"
                          Classes.degraded="{Binding UiQuotaTask.IsDegraded}"
                          Classes.error="{Binding UiQuotaTask.IsError}">
                    <TextBlock Classes="MptMeta" Text="{Binding UiQuotaTask.StateLabel}" />
                  </Border>
                  <TextBlock Classes="MptMeta" VerticalAlignment="Center" Text="{Binding UiQuotaTask.LastResultLabel}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- ── 本机动作与结果（全局，非来源级） ───────────────────────────── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <TextBlock Classes="MptSectionTitle" Text="本机动作与结果" Margin="{DynamicResource MptNoThickness}" />
            <TextBlock Classes="MptMeta" TextWrapping="Wrap"
                       Text="来源级本机动作（立即采集 / 验证窗口 / 立即发布）在各自行内；这里是全局动作。" />

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
              <controls:MptButton Content="重新读取日志"
                                  Command="{Binding RefreshLogsCommand}"
                                  IsEnabled="{Binding !IsActionRunning}" />
              <controls:MptButton Content="打开日志目录"
                                  Command="{Binding OpenLogsFolderCommand}"
                                  IsEnabled="{Binding !IsActionRunning}" />
            </StackPanel>

            <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding CollectorPathText, StringFormat='采集入口：{0}'}" />
            <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding WorkerLogDirectoryText, StringFormat='日志目录：{0}'}" />

            <StackPanel IsVisible="{Binding IsWorking}" Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptMeta" Text="{Binding WorkingText}" />
              <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
            </StackPanel>

            <Border Classes="MptInset" IsVisible="{Binding HasLastActionResult}">
              <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                <TextBlock FontWeight="SemiBold" Text="{Binding LastActionTitle}" />
                <SelectableTextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding LastActionResult}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ── 时间线：只记状态迁移 ──────────────────────────────────────── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
                <TextBlock Classes="MptSectionTitle" Text="状态迁移" Margin="{DynamicResource MptNoThickness}" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap"
                           Text="只记录状态迁移（ok↔degraded↔error↔stale、启用↔停用、Service Unit 启停）；不记录点击与刷新回声，动作证据留在各自行内。" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="MptMeta" VerticalAlignment="Center" Text="{Binding LastUpdatedText, StringFormat='更新 {0}'}" />
            </Grid>

            <Border Classes="MptEmptyState" IsVisible="{Binding IsTimelineEmpty}">
              <TextBlock Classes="MptEmptyState" Text="本次打开还没有状态迁移。" />
            </Border>

            <ItemsControl ItemsSource="{Binding Timeline}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:XbrdTimelineEntry">
                  <Border Classes="MptLogRow" Margin="{DynamicResource MptGapBottomXs}">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource MptSpacingS}">
                      <TextBlock Classes="MptMono" VerticalAlignment="Center" Text="{Binding TimeText}" />
                      <Border Grid.Column="1"
                              Classes="MptStatusBadge"
                              Classes.running="{Binding IsInfo}"
                              Classes.degraded="{Binding IsWarn}"
                              Classes.error="{Binding IsError}">
                        <TextBlock Classes="MptMeta" Text="{Binding LevelLabel}" />
                      </Border>
                      <TextBlock Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Message}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- ── 日志 ───────────────────────────────────────────────────────── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <TextBlock Classes="MptSectionTitle" Text="Service Unit 日志" Margin="{DynamicResource MptNoThickness}" />
            <TextBlock Classes="MptMeta" TextWrapping="Wrap"
                       Text="两个 Service Unit 的最近日志（IServiceUnitClient.TailLogsAsync）。单个来源的运行日志在「查看快照」抽屉里。" />
            <Border Classes="MptInset">
              <SelectableTextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding UnitLogText}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- ── 设置（只读诊断） ───────────────────────────────────────────── -->
        <Border Classes="MptCard">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptSectionTitle" Text="设置（只读诊断）" Margin="{DynamicResource MptNoThickness}" />
            <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding SettingsDiagnosticsText}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingM}"
                  RowSpacing="{DynamicResource MptSpacing2Xs}">
              <TextBlock Grid.Row="0" Classes="MptMeta" Text="publisherUrl" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="MptMono" TextWrapping="Wrap" Text="{Binding PublisherUrlText}" />
              <TextBlock Grid.Row="1" Classes="MptMeta" Text="panelUrl" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="MptMono" TextWrapping="Wrap" Text="{Binding PanelUrlText}" />
              <TextBlock Grid.Row="2" Classes="MptMeta" Text="xbrdRepoRoot" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="MptMono" TextWrapping="Wrap" Text="{Binding RepoRootText}" />
              <TextBlock Grid.Row="3" Classes="MptMeta" Text="connectionTimeoutMs" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimeoutText}" />
              <TextBlock Grid.Row="4" Classes="MptMeta" Text="间隔 / 自动刷新" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntervalText}" />
              <TextBlock Grid.Row="5" Classes="MptMeta" Text="来源开关" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SourcesEnabledText}" />
              <TextBlock Grid.Row="6" Classes="MptMeta" Text="声明的密钥" />
              <TextBlock Grid.Row="6" Grid.Column="1" Classes="MptMeta" TextWrapping="Wrap" Text="{Binding SecretsText}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ── 查看快照抽屉（revision / changed_fields / 原始 JSON / 真实日志） ── -->
    <Border IsVisible="{Binding IsDrawerOpen}"
            Background="{DynamicResource MptBrushOverlayScrim}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Classes="MptCard"
              Width="620"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="{DynamicResource MptSpacingM}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
            <StackPanel Spacing="{DynamicResource MptSpacing2Xs}" VerticalAlignment="Center">
              <TextBlock Classes="MptCardTitle" Text="{Binding DrawerTitle}" />
              <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DrawerStatusText}" />
              <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DrawerEnabledText}" />
            </StackPanel>
            <controls:MptButton Grid.Column="1"
                                Content="关闭"
                                Command="{Binding CloseDrawerCommand}"
                                VerticalAlignment="Top" />
          </Grid>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Margin="{DynamicResource MptGapTopM}">
            <StackPanel Spacing="{DynamicResource MptSpacingM}">
              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="归属与能力" />
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DrawerHintText}" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource MptSpacingM}"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock Grid.Row="0" Classes="MptMeta" Text="revision" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="MptMono" TextWrapping="Wrap" Text="{Binding DrawerRevisionText}" />
                <TextBlock Grid.Row="1" Classes="MptMeta" Text="时间" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="MptMono" TextWrapping="Wrap" Text="{Binding DrawerGeneratedText}" />
                <TextBlock Grid.Row="2" Classes="MptMeta" Text="changed_fields" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DrawerChangedFieldsText}" />
                <TextBlock Grid.Row="3" Classes="MptMeta" Text="error" />
                <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="{Binding DrawerErrorText}" />
              </Grid>

              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="原始快照（xbrd.source.summary.v1）" />
                <Border Classes="MptInset">
                  <SelectableTextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding DrawerSnapshotJson}" />
                </Border>
              </StackPanel>

              <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
                  <TextBlock Classes="MptMeta" FontWeight="SemiBold" Text="运行日志（路由器 /api/v1/sources/&lt;id&gt;/log）" VerticalAlignment="Center" />
                  <controls:MptButton Grid.Column="1"
                                      Content="读取日志"
                                      Command="{Binding LoadDrawerLogCommand}"
                                      IsEnabled="{Binding DrawerCanLoadLog}" />
                </Grid>
                <TextBlock Classes="MptMeta" TextWrapping="Wrap" Text="{Binding DrawerLogMetaText}" />
                <Border Classes="MptInset">
                  <SelectableTextBlock Classes="MptMono" TextWrapping="Wrap" Text="{Binding DrawerLogText}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
