<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Xbrd.CodexQuota.Service</AssemblyName>
    <RootNamespace>Xbrd.CodexQuota.Service</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>
      XBRD Codex quota source Service Unit (xbrd.codex-quota.service). Reads the Codex
      rate limits through MyPowerTools.Platform.Abstractions.CodexQuotaReader and publishes
      quota.codex source snapshots to the router publisher. Replaces the three overlapping
      producers (logon-trigger pythonw worker, Codex Stop hook, 5-minute trigger task).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consume the SDK package like every other first-party tool project. A
         ProjectReference through $(MyPowerToolsRepoRoot) escapes the tool directory
         and trips the A1.7 dependency-boundary gate. -->
    <PackageReference Include="MyPowerTools.Platform.Abstractions" Version="0.2.0" />
  </ItemGroup>
</Project>
